# 复制为 .env.web.local。默认只供本机浏览器访问。
HARNESS_WEB_HOST=127.0.0.1
HARNESS_WEB_PORT=4185
HARNESS_WEB_DATA_DIR=.local/web

# 局域网 HTTPS：填写证书路径；使用本地域名时，将其加入允许列表。
# HARNESS_WEB_HOST=0.0.0.0
# HARNESS_TLS_CERT=.local/web/tls/cert.pem
# HARNESS_TLS_KEY=.local/web/tls/key.pem
# HARNESS_WEB_ALLOWED_HOSTS=team.local

# 仅使用测试账号和测试 Key 的临时局域网 HTTP 模式：
# HARNESS_ALLOW_INSECURE_LAN=1

# 默认自动创建独立主密钥文件，请连同数据库一起妥善备份。
# HARNESS_WEB_MASTER_KEY_FILE=.local/web/secrets/master.key

# 独立 Pages 发布仓库（例：your-user/team-harness-web）
# HARNESS_PAGES_REPOSITORY=your-user/team-harness-web
# 直接配置跨域访问时，Origin 不含路径或末尾斜杠；share:pages 会按仓库自动设置。
# HARNESS_WEB_ALLOWED_ORIGINS=https://your-user.github.io

# 默认关闭公网隧道。只有明确同意第三方处理 API 请求后才可启用。
HARNESS_ALLOW_CLOUDFLARE=0
